# Template for .env.local. Copy it to .env.local and fill in the values.
# .env.local is gitignored; never commit real keys. This example file is committed.

# --- Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets -- paste your values after the "=" (no quotes, no spaces)
# Supabase dashboard > Connect > "Session pooler" connection string, with your DB password in it
DATABASE_URL=
# Supabase dashboard > Project Settings > API Keys > secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot protection (Cloudflare Turnstile). These are Cloudflare's official
# always-pass TEST keys for development; replace with real keys before go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Protects the scheduled job routes (/api/cron/*). Any long random string.
CRON_SECRET=
# Signs Client manage links (texts rebuild them). Long random string; changing it breaks old links.
MANAGE_LINK_SECRET=

# --- Texts (Twilio). Without these, texts are only printed to the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number texts come from, like +17185550000 (a Shop can have its own later)
TWILIO_FROM_NUMBER=
# Segments per Shop per day before texts wait (carrier limit for sole proprietors is ~1,000)
# SMS_DAILY_SEGMENT_CAP=900

# --- Barber alerts (Telegram bot from @BotFather). Without these, alerts are printed to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; npm run telegram:webhook gives it to Telegram
TELEGRAM_WEBHOOK_SECRET=

# --- Email (Resend). Without these, emails are printed to the log.
RESEND_API_KEY=
# Until you verify a domain, Resend only delivers to your own account email from onboarding@resend.dev
EMAIL_FROM=Barber Master <onboarding@resend.dev>

# --- Payments, test mode only (B2; Stripe is a placeholder provider). Without both,
# online payment stays off and refunds wait in the outbox.
# Secret key: Stripe dashboard (test mode) > Developers > API keys (sk_test_...).
STRIPE_SECRET_KEY=
# Webhook secret (whsec_...): printed by `stripe listen --forward-connect-to localhost:3000/api/payments/webhook`,
# or from the dashboard webhook endpoint (listen to events on Connected accounts).
STRIPE_WEBHOOK_SECRET=
