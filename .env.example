# Template for .env.local. Copy it to .env.local and fill in the values.
# .env.local is gitignored; never commit real keys. This example file is committed.

# --- Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets -- paste your values after the "=" (no quotes, no spaces)
# Supabase dashboard > Connect > "Session pooler" connection string, with your DB password in it
DATABASE_URL=
# Supabase dashboard > Project Settings > API Keys > secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot protection (Cloudflare Turnstile). These are Cloudflare's official
# always-pass TEST keys for development; replace with real keys before go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Not used yet (see progress.md "Accounts to create") ---
# Payments, test mode only (Stripe is a placeholder provider; it will be swapped later)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=
# Texts (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Barber alerts (Telegram bot from @BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Protects the scheduled job routes
# CRON_SECRET=
